{
  "name": "docs-cli",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "description": "Piloter docs.numerique.gouv.fr depuis la ligne de commande : pousser du Markdown en sous-documents, récupérer, lister, déplacer",
  "bin": {
    "docs": "src/cli.ts"
  },
  "scripts": {
    "preinstall": "node scripts/enforce-pnpm.cjs",
    "prepare": "node scripts/install-hooks.cjs",
    "docs": "node --use-system-ca --disable-warning=ExperimentalWarning src/cli.ts",
    "typecheck": "tsc -p .",
    "test": "node --disable-warning=ExperimentalWarning --test \"src/**/*.test.ts\"",
    "secrets:scan": "gitleaks git --redact --no-banner --config .gitleaks.toml && gitleaks git --pre-commit --redact --no-banner --config .gitleaks.toml"
  },
  "engines": {
    "node": ">=22.18"
  },
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "onFail": "error"
    }
  },
  "packageManager": "pnpm@12.4.2+sha512.08adc6613180275c7c9edada39dcf08c9c61ad4e7eaf330a4f3461f102b0f907423454d117f98e72d47fef0616070644d7bffc973a6a57f5090a6d7c368b07c9",
  "dependencies": {
    "playwright": "1.63.0",
    "yaml": "2.9.1",
    "yjs": "13.6.33"
  },
  "devDependencies": {
    "@types/node": "26.6.3",
    "typescript": "7.0.2"
  }
}
