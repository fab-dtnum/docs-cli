# À copier dans $DOCS_HOME/.env (défaut : ~/.config/docs-cli/.env), droits 600.
# `docs login` crée le fichier et remplit les deux premières lignes.
DOCS_SESSIONID=
DOCS_CSRFTOKEN=

# Instance (défaut : https://docs.numerique.gouv.fr)
# DOCS_BASE_URL=https://docs.numerique.gouv.fr

# Id (ou URL) du document dont les enfants sont les modèles de `docs new`
DOCS_TEMPLATES=/Users/pom/.config/docs/temmplates

# children (défaut) ou move : voir SPEC.md §4.2
# DOCS_CREATE_MODE=children
# DOCS_RATE_PER_MINUTE=60
# DOCS_CONCURRENCY=4
# DOCS_BROWSER=firefox

# Proxy d'entreprise
# HTTPS_PROXY=http://proxy.exemple:3128
# NO_PROXY=localhost,127.0.0.1
